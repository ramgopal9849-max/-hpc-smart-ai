# HPC Smart AI - Environment Configuration

APP_NAME="HPC Smart AI"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost

# Application Security
APP_KEY=
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hpc_smart_ai
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# AI Provider
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,docx,xlsx,csv,txt

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=storage

# Logging
LOG_LEVEL=warning
LOG_PATH=storage/logs

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
FORCE_HTTPS=true

# Default AI Permissions
AI_DEFAULT_MODE=READ_ONLY
AI_ALLOW_EXTERNAL_MODIFICATIONS=false
AI_REQUIRE_ADMIN_APPROVAL=true
