{
    "name": "hpc-smart-ai/backend",
    "description": "Secure backend API for HPC Smart AI",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.11",
        "monolog/monolog": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "HPC\\SmartAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HPC\\SmartAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": "php -l public/index.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
